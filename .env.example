# Copy to .env for local development. Never commit .env.
# .env is read only when APP_ENV is not prod. Real environment variables always win.
# Inline comments after unquoted values are OK.

APP_ENV=dev                 # dev | staging | prod
PORT=8080

# Neon: pooled URL for the app, direct (non-pooled) URL for Flyway migrations. JDBC format.
# Credentials can be in the URL (?user=...&password=...) or in DATABASE_USER / DATABASE_PASSWORD.
DATABASE_URL=jdbc:postgresql://<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&user=<user>&password=<password>
DATABASE_URL_DIRECT=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&user=<user>&password=<password>
DATABASE_USER=
DATABASE_PASSWORD=

# Firebase Admin: project id and the service-account JSON, base64-encoded on one line.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   bash:       base64 -w0 service-account.json
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON_B64=<base64>

# Gemini (backend only; the key never ships in the APK)
GEMINI_API_KEY=<key>
GEMINI_MODEL=gemini-3.6-flash      # gemini-2.5-flash is closed to new API keys (404)

# Shared secret for POST /internal/jobs/* and /internal/dev/* (header X-Job-Key)
JOB_KEY=<random-string>

# Staging only (ignored in prod)
DEV_TOOLS_ENABLED=false
CLOCK_OVERRIDE=             # ISO-8601 instant, e.g. 2026-10-04T00:05:00Z; leave empty for real time
