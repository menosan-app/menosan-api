<configuration>
    <!--
      Never log request bodies, tokens, emails, entry names, or images (plan §7, §14).
      Exposed logs SQL statements (with bound values) at DEBUG: keep it at WARN.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSX,UTC} %-5level [%X{requestId:-}] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="Exposed" level="WARN"/>
    <logger name="org.jetbrains.exposed" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.google" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
